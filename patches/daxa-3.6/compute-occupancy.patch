@@ -0,0 +1,24 @@
+#pragma once
+
+// Compatibility with the Vulkan headers shipped with Daxa 3.6.
+// Definitions from Khronos Vulkan-Headers, extension 646, revision 1.
+#ifndef VK_NV_compute_occupancy_priority
+#define VK_NV_compute_occupancy_priority 1
+#define VK_COMPUTE_OCCUPANCY_PRIORITY_HIGH_NV 0.75f
+// These enumerators are absent from older VkStructureType declarations.
+// C++ cannot extend an existing enum; preserve their official type and ABI values.
+inline constexpr VkStructureType VK_STRUCTURE_TYPE_COMPUTE_OCCUPANCY_PRIORITY_PARAMETERS_NV = static_cast<VkStructureType>(1000645000);
+inline constexpr VkStructureType VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_COMPUTE_OCCUPANCY_PRIORITY_FEATURES_NV = static_cast<VkStructureType>(1000645001);
+struct VkComputeOccupancyPriorityParametersNV {
+    VkStructureType sType;
+    void const *pNext;
+    float occupancyPriority;
+    float occupancyThrottling;
+};
+struct VkPhysicalDeviceComputeOccupancyPriorityFeaturesNV {
+    VkStructureType sType;
+    void *pNext;
+    VkBool32 computeOccupancyPriority;
+};
+using PFN_vkCmdSetComputeOccupancyPriorityNV = void (VKAPI_PTR *)(VkCommandBuffer, VkComputeOccupancyPriorityParametersNV const *);
+#endif
